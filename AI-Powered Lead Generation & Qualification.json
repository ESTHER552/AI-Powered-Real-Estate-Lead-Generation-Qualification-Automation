        "jsonBody": "={{\n  {\n    contents: [\n      {\n        role: \"user\",\n        parts: [\n          {\n            text: `You are an expert real estate lead qualification assistant.\n\nAnalyse the following property enquiry.\n\nEvaluate:\n- Property buying, selling or renting intent.\n- Available budget.\n- Preferred location.\n- Urgency and readiness.\n- Level of interest.\n\nAssign a score between 0 and 100.\n\nClassification:\n70-100 = Hot\n40-69 = Warm\n0-39 = Cold\n\nReturn valid JSON containing:\nscore,\ncategory,\nintent,\nurgency,\nreason,\nrecommended_action,\nfollow_up_message.\n\nDo not invent information.\n\nLead information:\n${JSON.stringify($json)}`\n          }\n        ]\n      }\n    ],\n    generationConfig: {\n      temperature: 0.2,\n      responseMimeType: \"application/json\"\n    }\n  }\n}}",
