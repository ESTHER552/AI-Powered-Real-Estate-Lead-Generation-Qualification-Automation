    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// Extract Gemini's response\nconst aiText = response.candidates[0].content.parts[0].text;\n\n// Convert AI response from text into JSON\nconst assessment = JSON.parse(aiText);\n\n// Retrieve original lead information\nconst lead = $('Edit Fields').first().json;\n\n// Combine lead information with AI assessment\nreturn [\n  {\n    json: {\n      ...lead,\n      score: assessment.score,\n      category: assessment.category,\n      intent: assessment.intent,\n      urgency: assessment.urgency,\n      reason: assessment.reason,\n      recommended_action: assessment.recommended_action,\n      follow_up_message: assessment.follow_up_message,\n      qualified_at: new Date().toISOString(),\n      follow_up_status: \"Pending\"\n    }\n  }\n];"
      },
